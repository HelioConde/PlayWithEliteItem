<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- References for the current Risk of Rain 2 equipment location API. -->
    <PackageReference Include="RoR2BepInExPack" Version="1.48.0" />
    <!-- Compile-time On.RoR2 hook declarations; BepInExPack handles runtime hooks. -->
    <PackageReference Include="MMHOOK.RoR2" Version="*" NoWarn="NU1701" />
  </ItemGroup>
</Project>
