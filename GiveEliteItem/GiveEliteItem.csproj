<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the current RoR2/BepInEx public API.
         No MMHOOK package is needed: this plugin installs no hooks. -->
    <PackageReference Include="RoR2BepInExPack" Version="1.48.0" />
  </ItemGroup>
</Project>
